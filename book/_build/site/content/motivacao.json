{"line":5,"column":1}},"children":[{"type":"text","value":"Hermes","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"dmHFupMhlA"}],"key":"CWFTL8xP9X"},{"type":"text","value":" — deus da comunicação, das mensagens e das travessias — e ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"S0qsxhY3Pg"},{"type":"strong","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Atena","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"cyJecM6pN1"}],"key":"YcAaCZkQo3"},{"type":"text","value":" — deusa da sabedoria, da ciência e das artes. Para Cícero, a peça representava o ideal de que o conhecimento e a eloquência são inseparáveis: não basta saber, é preciso saber comunicar.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Fa9KMRoskb"}],"key":"XdWO0rmbWm"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"É com esse espírito que o projeto Hermathena se propõe a construir pontes entre a pesquisa científica de excelência conduzida no âmbito do Radiotelescópio BINGO e a sociedade paraibana — em especial as comunidades do sertão que convivem, literalmente, com um dos instrumentos científicos mais sofisticados já construídos no Brasil.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"GcHI6Rmzkk"}],"key":"P8e7E0e3H4"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"O projeto é um desdobramento direto do Programa de Extensão BINGO (PROBEX/UFCG), e emerge num momento em que o investimento em ciência e tecnologia no Estado da Paraíba alcança uma escala histórica, articulando instituições de ensino, esferas de governo e parceiros internacionais em torno de três grandes iniciativas:","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"HLm4I8lnau"}],"key":"OOhGzcftty"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":11,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"O ","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"tnTghe7j2W"},{"type":"strong","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Radiotelescópio BINGO","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"yMQIuVl6RN"}],"key":"skXhPmiqti"},{"type":"text","value":", em Aguiar;","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"XOdAxux4iT"}],"key":"uv5gxzlE4b"}],"key":"NZVc74PPs1"},{"type":"listItem","spread":true,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"A ","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"N0nUucMeTc"},{"type":"strong","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Cidade da Astronomia","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"YDxcnqdN99"}],"key":"RzrAERZhTZ"},{"type":"text","value":", em Carrapateira;","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"MEzuEki1py"}],"key":"OG3zs1PyDz"}],"key":"Bu2rtkCDmO"},{"type":"listItem","spread":true,"position":{"start":{"line":13,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"O ","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"aENjWdZn1O"},{"type":"strong","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Centro de Computação Quântica","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"sEyTUAYUhS"}],"key":"BuQDEfkyew"},{"type":"text","value":", em fase de planejamento.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"k5NaGLJ8LC"}],"key":"k7OeJQeYuB"}],"key":"UNZ9xOiThZ"}],"key":"QgLuxSiHSs"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Diante desse cenário, comunicar ciência deixa de ser uma obrigação burocrática e torna-se um ato político e pedagógico: é a condição para que o desenvolvimento científico se converta em desenvolvimento humano.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"pebRVdji1d"}],"key":"pCZihAW34y"},{"type":"thematicBreak","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"XM9nwUWWZ6"},{"type":"heading","depth":2,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"1.2 Missão","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"S63VzmL1MH"}],"identifier":"id-1-2-miss-o","label":"1.2 Missão","html_id":"id-1-2-miss-o","implicit":true,"key":"L02gsL0Iqm"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Estabelecer as bases para garantir, registrar e potencializar as ações das equipes envolvidas com o Radiotelescópio BINGO, conducentes à materialização do projeto como vetor de desenvolvimento humano, científico, educacional e econômico no Estado da Paraíba e região Nordeste.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"tVoT0QaVGg"}],"key":"cqmFxAMDnJ"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Este significado foi rapidamente compreendido pelos membros da colaboração, pelos gestores das instituições públicas de ensino da Paraíba, por órgãos de fomento e, sobretudo, pelo Governo do Estado da Paraíba, que aportou recursos significativos além de planejar e iniciar obras estruturantes no alto sertão — com a pavimentação das rodovias do entorno do radiotelescópio e com a criação do projeto Cidade da Astronomia, no município de Carrapateira.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"dCzPf6Tvg8"}],"key":"sJ79qFEJpW"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"O Radiotelescópio BINGO é, por natureza, um projeto inter e transdisciplinar. Sua construção e operação mobilizam simultaneamente competências em física, engenharia, computação, ciências ambientais, ciências sociais e comunicação — áreas que não apenas coexistem, mas precisam dialogar para que o projeto cumpra seu potencial. Essa característica se reflete diretamente na estrutura do projeto Hermathena, que reúne equipes de diferentes instituições — UFCG, UFPB, UEPB, IFPB, além de parceiros internacionais — numa prática genuína de ciência colaborativa, em que o conhecimento é produzido e compartilhado de forma distribuída, superando fronteiras disciplinares e institucionais.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"M5psmJACfA"}],"key":"Q1EC1DF3vi"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Mais do que um feito científico, a instalação do BINGO no sertão paraibano representa uma oportunidade concreta de enfrentamento de demandas históricas da população regional: a escassez de oportunidades educacionais e profissionais em uma das regiões mais carentes do estado, a ausência de infraestrutura tecnológica e a distância entre as comunidades locais e os circuitos de produção do conhecimento. Nesse sentido, o esforço de comunicação científica proposto pelo Hermathena é também um esforço educacional — voltado para despertar vocações científicas e tecnológicas nas novas gerações, fortalecer a formação de professores da educação básica e criar laços duradouros entre a universidade e a sociedade do sertão.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"liRGKnCWV1"}],"key":"hrvTe8cta6"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"É fundamental, portanto, que esse movimento de investimento público e científico seja acompanhado por uma comunicação à altura: capaz de explicar à sociedade o que está sendo construído em seu território, de engajar as comunidades locais como protagonistas desse processo e de traduzir a linguagem da ciência de fronteira em oportunidades concretas de desenvolvimento humano e regional.","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"wcvQTJKh00"}],"key":"Nc8Ukh0x6H"},{"type":"heading","depth":2,"position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"1.3 Pilares Estratégicos","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"vKOSq1zoJz"}],"identifier":"id-1-3-pilares-estrat-gicos","label":"1.3 Pilares Estratégicos","html_id":"id-1-3-pilares-estrat-gicos","implicit":true,"key":"j3aYGUXcsu"},{"type":"table","position":{"start":{"line":34,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"tableRow","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"tableCell","header":true,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Pilar","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"gCw960bUnI"}],"key":"K5BVkZPGpq"},{"type":"tableCell","header":true,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1